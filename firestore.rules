rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function hasUserDoc() {
      return exists(/databases/$(database)/documents/usuarios/$(uid()));
    }

    function me() {
      return get(/databases/$(database)/documents/usuarios/$(uid()));
    }

    function isGlobalActiveUser() {
      return signedIn() && hasUserDoc() && me().data.ativoGlobal == true;
    }

    function myPlatformRole() {
      return hasUserDoc() ? me().data.platformRole : 'none';
    }

    function isPlatformAdmin() {
      return isGlobalActiveUser() && myPlatformRole() == 'platform_admin';
    }

    function myAccountContractLock() {
      return hasUserDoc() && me().data.accountContractLock is string
        ? me().data.accountContractLock
        : 'flexible';
    }

    function membershipId(tenantId) {
      return tenantId + '_' + uid();
    }

    function hasMembershipDoc(tenantId) {
      return exists(/databases/$(database)/documents/tenant_memberships/$(membershipId(tenantId)));
    }

    function isPersonalWorkspaceTenant(tenantId) {
      return tenantId == 'personal_' + uid();
    }

    function isSoloTenant(tenantId) {
      return tenantId == 'solo_' + uid();
    }

    function isSelfServiceTeamOrEnterpriseTenant(tenantId) {
      return tenantId.matches('^self_' + uid() + '_[a-z0-9-]+$');
    }

    function isSelfServiceOwnerTenantId(tenantId) {
      return isSoloTenant(tenantId)
        || isSelfServiceTeamOrEnterpriseTenant(tenantId);
    }

    function hasActiveMembership(tenantId) {
      return hasMembershipDoc(tenantId)
        && get(/databases/$(database)/documents/tenant_memberships/$(membershipId(tenantId))).data.ativo == true;
    }

    function myMembership(tenantId) {
      return get(/databases/$(database)/documents/tenant_memberships/$(membershipId(tenantId)));
    }

    function myTenantRole(tenantId) {
      return hasMembershipDoc(tenantId) && myMembership(tenantId).data.ativo == true
        ? myMembership(tenantId).data.role
        : '';
    }

    function isTenantOwner(tenantId) {
      return myTenantRole(tenantId) == 'owner';
    }

    function isTenantDocumentOwner(tenantId) {
      return exists(/databases/$(database)/documents/tenants/$(tenantId))
        && get(/databases/$(database)/documents/tenants/$(tenantId)).data.ownerUid == uid();
    }

    function isEffectiveTenantOwner(tenantId) {
      return isTenantOwner(tenantId) || isTenantDocumentOwner(tenantId);
    }

    function hasTenantAccessContext(tenantId) {
      return hasActiveMembership(tenantId) || isTenantDocumentOwner(tenantId);
    }

    function isTenantGerente(tenantId) {
      return myTenantRole(tenantId) == 'gerente';
    }

    function isTenantRepresentante(tenantId) {
      return myTenantRole(tenantId) == 'representante';
    }

    function isTenantVendedor(tenantId) {
      return myTenantRole(tenantId) == 'vendedor';
    }

    function isSellerSoloWorkspace(tenantId) {
      return tenantWorkspaceType(tenantId) == 'seller_solo_workspace';
    }

    function isRepWorkspace(tenantId) {
      return tenantWorkspaceType(tenantId) == 'rep_workspace';
    }

    function isBrandOwnerWorkspace(tenantId) {
      return tenantWorkspaceType(tenantId) == 'brand_owner_workspace';
    }

    function hasAnyTenantRole(tenantId) {
      return myTenantRole(tenantId) in ['owner', 'gerente', 'representante', 'vendedor'];
    }

    function hasTenantRoleIn(tenantId, roles) {
      return myTenantRole(tenantId) in roles;
    }

    function tenantWorkspaceType(tenantId) {
      return exists(/databases/$(database)/documents/tenants/$(tenantId))
        && get(/databases/$(database)/documents/tenants/$(tenantId)).data.workspaceType is string
          ? get(/databases/$(database)/documents/tenants/$(tenantId)).data.workspaceType
          : 'brand_owner_workspace';
    }

    function tenantProductSyncFromErpEnabled(tenantId) {
      return exists(/databases/$(database)/documents/tenants/$(tenantId))
        && get(/databases/$(database)/documents/tenants/$(tenantId)).data.productSyncFromErpEnabled == true;
    }

    function productSyncEnabledFromData(data) {
      return ('productSyncFromErpEnabled' in data)
        && data.productSyncFromErpEnabled is bool
        ? data.productSyncFromErpEnabled
        : false;
    }

    function validProductSyncFlagForWorkspace(data) {
      return data.workspaceType == 'brand_owner_workspace'
        || productSyncEnabledFromData(data) == false;
    }

    function canChangeProductSyncFlag(tenantId) {
      return productSyncEnabledFromData(resource.data) == productSyncEnabledFromData(request.resource.data)
        || (
          isBrandOwnerWorkspace(tenantId)
          && isEffectiveTenantOwner(tenantId)
        );
    }

    function canManageRepresentedCompanyPreferenceUpdate(tenantId) {
      return (
          (isRepWorkspace(tenantId)
            && (isEffectiveTenantOwner(tenantId)
              || hasTenantRoleIn(tenantId, ['representante'])))
          || (isSellerSoloWorkspace(tenantId)
            && hasTenantRoleIn(tenantId, ['vendedor']))
        );
    }

    function isRepresentedPreferenceOnlyTenantUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'representedCompanies',
        'favoriteRepresentedCompanyId',
        'updatedAt'
      ]);
    }

    function validTaxRegime(value) {
      return value in ['simples_nacional', 'lucro_presumido', 'lucro_real'];
    }

    function canReadTenantDocument(tenantId) {
      return isPlatformAdmin() || hasTenantAccessContext(tenantId);
    }

    function canReadTenantBoundDocument(data) {
      return isPlatformAdmin()
        || (hasTenantField(data) && (
          canAccessOwnPersonalData(data)
          || hasTenantAccessContext(data.tenantId)
        ));
    }

    function canAccessTenantWorkflow(tenantId) {
      return isPlatformAdmin()
        || isPersonalWorkspaceTenant(tenantId)
        || hasAnyTenantRole(tenantId)
        || isTenantDocumentOwner(tenantId);
    }

    function allowManagerSendInvitesByPolicy(tenantId) {
      return exists(/databases/$(database)/documents/tenants/$(tenantId))
        && get(/databases/$(database)/documents/tenants/$(tenantId)).data.policy is map
        && get(/databases/$(database)/documents/tenants/$(tenantId)).data.policy.allowManagerSendInvites is bool
          ? get(/databases/$(database)/documents/tenants/$(tenantId)).data.policy.allowManagerSendInvites
          : false;
    }

    function allowRepresentativeSendInvitesByPolicy(tenantId) {
      return exists(/databases/$(database)/documents/tenants/$(tenantId))
        && get(/databases/$(database)/documents/tenants/$(tenantId)).data.policy is map
        && get(/databases/$(database)/documents/tenants/$(tenantId)).data.policy.allowRepresentativeSendInvites is bool
          ? get(/databases/$(database)/documents/tenants/$(tenantId)).data.policy.allowRepresentativeSendInvites
          : false;
    }

    function canInviteRoleForTenant(tenantId, targetRole) {
      return isPlatformAdmin()
        || (
          hasTenantAccessContext(tenantId)
          && (
            (isSellerSoloWorkspace(tenantId) && false)
            || (
              isRepWorkspace(tenantId)
              && (
                (isEffectiveTenantOwner(tenantId)
                  && (targetRole == 'representante' || targetRole == 'vendedor'))
                || (hasTenantRoleIn(tenantId, ['representante'])
                  && allowRepresentativeSendInvitesByPolicy(tenantId)
                  && targetRole == 'vendedor')
              )
            )
            || (
              isBrandOwnerWorkspace(tenantId)
              && (
                (isEffectiveTenantOwner(tenantId)
                  && (targetRole == 'gerente'
                    || targetRole == 'representante'
                    || targetRole == 'vendedor'))
                || (hasTenantRoleIn(tenantId, ['gerente'])
                  && allowManagerSendInvitesByPolicy(tenantId)
                  && targetRole == 'representante')
                || (hasTenantRoleIn(tenantId, ['representante'])
                  && allowRepresentativeSendInvitesByPolicy(tenantId)
                  && targetRole == 'vendedor')
              )
            )
          )
        );
    }

    function canManageMembershipByDirectSuperior(data) {
      return hasTenantAccessContext(data.tenantId)
        && (
          (
            isRepWorkspace(data.tenantId)
            && (
              (data.role == 'representante'
                && isEffectiveTenantOwner(data.tenantId)
                && data.ownerId == uid())
              || (data.role == 'vendedor'
                && (
                  (isEffectiveTenantOwner(data.tenantId)
                    && data.ownerId == uid())
                  || (isTenantRepresentante(data.tenantId)
                    && data.representanteId == uid()
                    && data.gerenteId == myMembership(data.tenantId).data.gerenteId
                    && data.ownerId == myMembership(data.tenantId).data.ownerId)
                ))
            )
          )
          || (
            isBrandOwnerWorkspace(data.tenantId)
            && (
              (data.role == 'gerente'
                && isEffectiveTenantOwner(data.tenantId)
                && data.ownerId == uid())
              || (data.role == 'representante'
                && (
                  (isEffectiveTenantOwner(data.tenantId)
                    && data.ownerId == uid()
                    && data.gerenteId is string
                    && data.gerenteId != '')
                  || (isTenantGerente(data.tenantId)
                    && data.gerenteId == uid()
                    && data.ownerId == myMembership(data.tenantId).data.ownerId)
                ))
              || (data.role == 'vendedor'
                && (
                  (isEffectiveTenantOwner(data.tenantId)
                    && data.ownerId == uid()
                    && data.gerenteId is string
                    && data.gerenteId != ''
                    && data.representanteId is string
                    && data.representanteId != '')
                  || (isTenantRepresentante(data.tenantId)
                    && data.representanteId == uid()
                    && data.gerenteId == myMembership(data.tenantId).data.gerenteId
                    && data.ownerId == myMembership(data.tenantId).data.ownerId)
                ))
            )
          )
        );
    }

    function hasTenantField(data) {
      return data.tenantId is string && data.tenantId != '';
    }

    function hasScopeFields(data) {
      return hasTenantField(data)
        && data.ownerId is string
        && data.gerenteId is string
        && data.representanteId is string
        && data.vendedorId is string;
    }

    // A personal/no-tenant account (tenantId == 'personal_<uid>') has no
    // hierarchy at all — the sole user is effectively the owner of their own
    // data, with normal full CRUD permission on it. This bypass must apply
    // uniformly everywhere scoped data is read/written/deleted; only once a
    // real tenant is involved does the owner/gerente/representante/vendedor
    // layered model in the functions below take over.
    function canAccessOwnPersonalData(data) {
      return isPersonalWorkspaceTenant(data.tenantId);
    }

    function canWriteScopedData(data) {
      return isPlatformAdmin()
        || canAccessOwnPersonalData(data)
        || (hasTenantAccessContext(data.tenantId) && (
          (isEffectiveTenantOwner(data.tenantId) && data.ownerId == uid())
          || (isTenantGerente(data.tenantId)
            && data.gerenteId == uid()
            && data.ownerId == myMembership(data.tenantId).data.ownerId)
          || (isTenantRepresentante(data.tenantId)
            && data.representanteId == uid()
            && data.gerenteId == myMembership(data.tenantId).data.gerenteId
            && data.ownerId == myMembership(data.tenantId).data.ownerId)
          || (isTenantVendedor(data.tenantId)
            && data.vendedorId == uid()
            && data.representanteId == myMembership(data.tenantId).data.representanteId
            && data.gerenteId == myMembership(data.tenantId).data.gerenteId
            && data.ownerId == myMembership(data.tenantId).data.ownerId)
        ));
    }

    // Lifecycle actions (excluir cliente oficial) are destructive and, once a
    // real tenant hierarchy is involved, must be restricted to the tenant
    // owner — never a gerente/representante/vendedor, even if they can write
    // regular field updates on their own scope. A personal/no-tenant account
    // has no hierarchy, so it keeps normal full permission on its own data.
    function canDeleteCliente(data) {
      return isPlatformAdmin()
        || canAccessOwnPersonalData(data)
        || (isEffectiveTenantOwner(data.tenantId) && data.ownerId == uid());
    }

    function immutableScopeOnUpdate() {
      return resource.data.tenantId == request.resource.data.tenantId
        && resource.data.ownerId == request.resource.data.ownerId
        && resource.data.gerenteId == request.resource.data.gerenteId
        && resource.data.representanteId == request.resource.data.representanteId
        && resource.data.vendedorId == request.resource.data.vendedorId;
    }

    function validTenantDoc(tenantId, data) {
      return data.tenantId == tenantId
        && data.slug is string
        && data.nomeFantasia is string
        && data.ativo is bool
        && data.operationMode in ['manual', 'sankhya', 'custom']
        && data.erpProvider in ['none', 'sankhya', 'custom']
        && (!('taxRegime' in data)
          || (data.taxRegime is string && validTaxRegime(data.taxRegime)))
        && validOptionalTenantPolicy(data);
    }

    function validOptionalTenantPolicy(data) {
      return !('policy' in data)
        || (
          data.policy is map
          && (!('allowManagerDisableRepresentative' in data.policy)
            || data.policy.allowManagerDisableRepresentative is bool)
          && (!('allowRepresentativeDisableSeller' in data.policy)
            || data.policy.allowRepresentativeDisableSeller is bool)
          && (!('allowManagerSendInvites' in data.policy)
            || data.policy.allowManagerSendInvites is bool)
          && (!('allowRepresentativeSendInvites' in data.policy)
            || data.policy.allowRepresentativeSendInvites is bool)
          && (!('allowPersonalWorkspace' in data.policy)
            || data.policy.allowPersonalWorkspace is bool)
        );
    }

    function validWorkspaceTypeFields(data) {
      return data.workspaceType in ['seller_solo_workspace', 'rep_workspace', 'brand_owner_workspace']
        && data.hierarchyModel in ['seller_only', 'rep_to_seller', 'full_chain']
        && data.allowInvitations is bool
        && data.cnpjBinding in ['informational_only', 'owner_legal_entity'];
    }

    function validPlatformUserDoc(targetUid, data) {
      return data.uid == targetUid
        && data.email is string
        && data.displayName is string
        && data.platformRole in ['platform_admin', 'none']
        && data.ativoGlobal is bool;
    }

    function validSelfServiceUserDoc(targetUid, data) {
      return validPlatformUserDoc(targetUid, data)
        && targetUid == uid()
        && data.platformRole == 'none'
        && data.ativoGlobal == true;
    }

    function validTenantRole(role) {
      return role in ['owner', 'gerente', 'representante', 'vendedor'];
    }

    function validSoloMembershipHierarchy(data) {
      return data.role == 'vendedor'
        && data.ownerId == ''
        && data.gerenteId == ''
        && data.representanteId == ''
        && data.vendedorId == data.uid;
    }

    function validRepMembershipHierarchy(data) {
      return (data.role == 'owner'
          && data.ownerId == data.uid
          && data.gerenteId == data.uid
          && data.representanteId == data.uid
          && data.vendedorId == data.uid)
        || (data.role == 'representante'
          && data.ownerId is string
          && data.ownerId != ''
          && data.gerenteId is string
          && data.gerenteId != ''
          && data.representanteId == data.uid
          && data.vendedorId == data.uid)
        || (data.role == 'vendedor'
          && data.ownerId is string
          && data.ownerId != ''
          && data.gerenteId is string
          && data.gerenteId != ''
          && data.representanteId is string
          && data.representanteId != ''
          && data.vendedorId == data.uid);
    }

    function validEnterpriseMembershipHierarchy(data) {
      return (data.role == 'owner'
          && data.ownerId == data.uid
          && data.gerenteId == data.uid
          && data.representanteId == data.uid
          && data.vendedorId == data.uid)
        || (data.role == 'gerente'
          && data.ownerId is string
          && data.ownerId != ''
          && data.gerenteId == data.uid
          && data.representanteId == data.uid
          && data.vendedorId == data.uid)
        || (data.role == 'representante'
          && data.ownerId is string
          && data.ownerId != ''
          && data.gerenteId is string
          && data.gerenteId != ''
          && data.representanteId == data.uid
          && data.vendedorId == data.uid)
        || (data.role == 'vendedor'
          && data.ownerId is string
          && data.ownerId != ''
          && data.gerenteId is string
          && data.gerenteId != ''
          && data.representanteId is string
          && data.representanteId != ''
          && data.vendedorId == data.uid);
    }

    function validMembershipHierarchy(data) {
      return (isSellerSoloWorkspace(data.tenantId) && validSoloMembershipHierarchy(data))
        || (isRepWorkspace(data.tenantId) && validRepMembershipHierarchy(data))
        || (isBrandOwnerWorkspace(data.tenantId) && validEnterpriseMembershipHierarchy(data));
    }

    function validMembershipBaseDoc(membershipKey, data) {
      return data.membershipId == membershipKey
        && membershipKey == data.tenantId + '_' + data.uid
        && data.tenantId is string
        && data.uid is string
        && validTenantRole(data.role)
        && data.ativo is bool
        && data.defaultTenant is bool
        && data.ownerId is string
        && data.gerenteId is string
        && data.representanteId is string
        && data.vendedorId is string
        && data.activeSellerChildrenCount is int
        && data.activeSellerChildrenCount >= 0
        && data.activeRepresentativeChildrenCount is int
        && data.activeRepresentativeChildrenCount >= 0
        && data.activeSubordinateCount is int
        && data.activeSubordinateCount >= 0
        && data.activeSubordinateCount == data.activeSellerChildrenCount + data.activeRepresentativeChildrenCount;
    }

    function hasZeroHierarchyAggregates(data) {
      return data.activeSellerChildrenCount == 0
        && data.activeRepresentativeChildrenCount == 0
        && data.activeSubordinateCount == 0;
    }

    function validMembershipDoc(membershipKey, data) {
      return validMembershipBaseDoc(membershipKey, data)
        && validMembershipHierarchy(data);
    }

    function validManagedMembershipByDirectSuperior(membershipKey, data) {
      return validMembershipBaseDoc(membershipKey, data)
        && (
          (data.ativo == true && data.state == 'active')
          || (data.ativo == false && data.state in ['inactive', 'revoked'])
        )
        && data.defaultTenant is bool
        && (
          (
            isRepWorkspace(data.tenantId)
            && (
              (data.role == 'representante'
                && data.ownerId == uid()
                && data.gerenteId == uid()
                && data.representanteId == data.uid
                && data.vendedorId == data.uid)
              || (data.role == 'vendedor'
                && data.ownerId == myMembership(data.tenantId).data.ownerId
                && data.gerenteId == myMembership(data.tenantId).data.gerenteId
                && data.representanteId is string
                && data.representanteId != ''
                && data.vendedorId == data.uid)
            )
          )
          || (
            isBrandOwnerWorkspace(data.tenantId)
            && (
              (data.role == 'gerente'
                && data.ownerId == uid()
                && data.gerenteId == data.uid
                && data.representanteId == data.uid
                && data.vendedorId == data.uid)
              || (data.role == 'representante'
                && (
                  (isEffectiveTenantOwner(data.tenantId)
                    && data.ownerId == uid()
                    && data.gerenteId is string
                    && data.gerenteId != ''
                    && data.representanteId == data.uid
                    && data.vendedorId == data.uid)
                  || (data.ownerId == myMembership(data.tenantId).data.ownerId
                    && data.gerenteId == uid()
                    && data.representanteId == data.uid
                    && data.vendedorId == data.uid)
                ))
              || (data.role == 'vendedor'
                && (
                  (isEffectiveTenantOwner(data.tenantId)
                    && data.ownerId == uid()
                    && data.gerenteId is string
                    && data.gerenteId != ''
                    && data.representanteId is string
                    && data.representanteId != ''
                    && data.vendedorId == data.uid)
                  || (data.ownerId == myMembership(data.tenantId).data.ownerId
                    && data.gerenteId == myMembership(data.tenantId).data.gerenteId
                    && data.representanteId == uid()
                    && data.vendedorId == data.uid)
                ))
            )
          )
        );
    }

    function validSelfServiceOwnerTenantDoc(tenantId, data) {
      return validSelfServiceTenantBase(tenantId, data)
        && (
          (data.plan == 'solo' && validSoloSelfServiceTenantConfig(tenantId, data))
          || (data.plan == 'team' && validRepSelfServiceTenantConfig(tenantId, data))
          || (data.plan == 'enterprise' && validEnterpriseSelfServiceTenantConfig(tenantId, data))
        );
    }

    function canUseWorkspaceTypeUnderAccountContract(workspaceType) {
      return workspaceType == 'brand_owner_workspace'
        || myAccountContractLock() != 'enterprise_only';
    }

    function canAttemptSelfServiceTenantMutation(tenantId, data) {
      return data.tenantId == tenantId
        && data.ownerUid is string
        && data.ownerUid == uid()
        && data.plan in ['solo', 'team', 'enterprise']
        && data.workspaceType in ['seller_solo_workspace', 'rep_workspace', 'brand_owner_workspace']
        && data.ativo == true
        && data.operationMode == 'manual'
        && data.erpProvider == 'none'
        && canUseWorkspaceTypeUnderAccountContract(data.workspaceType);
    }

    function validSelfServiceTenantBase(tenantId, data) {
      return isSelfServiceOwnerTenantId(tenantId)
        && data.slug is string
        && data.nomeFantasia is string
        && validWorkspaceTypeFields(data)
        && validProductSyncFlagForWorkspace(data);
    }

    function hasStableTenantIdentityOnUpdate(tenantId) {
      return request.resource.data.tenantId == tenantId
        && request.resource.data.workspaceType == resource.data.workspaceType
        && request.resource.data.plan == resource.data.plan
        && request.resource.data.ownerUid == resource.data.ownerUid;
    }

    function canUpdateTenantRepresentedPreferences(tenantId) {
      return isRepresentedPreferenceOnlyTenantUpdate()
        && canManageRepresentedCompanyPreferenceUpdate(tenantId);
    }

    function canUpdateTenantCoreDocument(tenantId) {
      return !isRepresentedPreferenceOnlyTenantUpdate()
        && (
          canTenantOwnerManageTenantDocumentUpdate(tenantId)
          || canSelfServiceOwnerUpdateTenant(tenantId)
        );
    }

    function canUpdateTenantAsNonAdmin(tenantId) {
      return hasStableTenantIdentityOnUpdate(tenantId)
        && (
          canUpdateTenantRepresentedPreferences(tenantId)
          || canUpdateTenantCoreDocument(tenantId)
        );
    }

    function validSoloSelfServiceTenantConfig(tenantId, data) {
      return data.plan == 'solo'
        && isSoloTenant(tenantId)
        && data.workspaceType == 'seller_solo_workspace'
        && data.hierarchyModel == 'seller_only'
        && data.allowInvitations == false
        && data.cnpjBinding == 'informational_only';
    }

    function validRepSelfServiceTenantConfig(tenantId, data) {
      return data.plan == 'team'
        && isSelfServiceTeamOrEnterpriseTenant(tenantId)
        && data.workspaceType == 'rep_workspace'
        && data.hierarchyModel in ['rep_to_seller', 'full_chain']
        && data.allowInvitations == true
        && data.cnpjBinding == 'informational_only';
    }

    function validEnterpriseSelfServiceTenantConfig(tenantId, data) {
      return data.plan == 'enterprise'
        && isSelfServiceTeamOrEnterpriseTenant(tenantId)
        && data.workspaceType == 'brand_owner_workspace'
        && data.hierarchyModel == 'full_chain'
        && data.allowInvitations == true
        && data.cnpjBinding == 'owner_legal_entity';
    }

    function canManageProductCatalogWrite(tenantId) {
      return isPlatformAdmin()
        || isPersonalWorkspaceTenant(tenantId)
        || (
          hasTenantAccessContext(tenantId)
          && (!isBrandOwnerWorkspace(tenantId)
            || !tenantProductSyncFromErpEnabled(tenantId))
          && (
            (isBrandOwnerWorkspace(tenantId) && isEffectiveTenantOwner(tenantId))
            || isRepWorkspace(tenantId)
            || (isSellerSoloWorkspace(tenantId)
              && hasTenantRoleIn(tenantId, ['owner', 'vendedor']))
          )
        );
    }

    function canManagePriceTableWrite(tenantId) {
      return isPlatformAdmin()
        || isPersonalWorkspaceTenant(tenantId)
        || (
          hasTenantAccessContext(tenantId)
          && (
            (isBrandOwnerWorkspace(tenantId)
              && (isEffectiveTenantOwner(tenantId) || isTenantGerente(tenantId)))
            || isRepWorkspace(tenantId)
            || (isSellerSoloWorkspace(tenantId)
              && hasTenantRoleIn(tenantId, ['owner', 'vendedor']))
          )
        );
    }

    function canManageTaxRulesWrite(tenantId) {
      return isPlatformAdmin()
        || isPersonalWorkspaceTenant(tenantId)
        || (
          hasTenantAccessContext(tenantId)
          && (
            (isSellerSoloWorkspace(tenantId) && isEffectiveTenantOwner(tenantId))
            || (isRepWorkspace(tenantId) && isEffectiveTenantOwner(tenantId))
            || (isBrandOwnerWorkspace(tenantId)
              && (isEffectiveTenantOwner(tenantId) || isTenantGerente(tenantId)))
          )
        );
    }

    function canManageRepresentedCompanyWrite(tenantId) {
      return isPlatformAdmin()
        || (
          hasTenantAccessContext(tenantId)
          && (
            ((isSellerSoloWorkspace(tenantId)
              || isRepWorkspace(tenantId))
              && (isEffectiveTenantOwner(tenantId)
                || hasTenantRoleIn(tenantId, ['representante'])))
            || (isBrandOwnerWorkspace(tenantId)
              && isEffectiveTenantOwner(tenantId))
          )
        );
    }

    function validRepresentedCompanyCnpj(value) {
      return value is string
        && value.matches('^[0-9]{2}\\.[0-9]{3}\\.[0-9]{3}/[0-9]{4}-[0-9]{2}$');
    }

    function validRepresentedCompanyCep(value) {
      return value is string
        && (value == '' || value.matches('^[0-9]{5}-[0-9]{3}$'));
    }

    function validRepresentedCompanyPhone(value) {
      return value is string
        && (value == '' || value.matches('^\\([0-9]{2}\\) [0-9]{4,5}-[0-9]{4}$'));
    }

    function validRepresentedCompanyEmail(value) {
      return value is string
        && (value == ''
          || value.matches('^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$'));
    }

    function validRepresentedCompanyUf(value) {
      return value is string
        && value in [
          'AC', 'AL', 'AP', 'AM', 'BA', 'CE', 'DF', 'ES', 'GO', 'MA', 'MT',
          'MS', 'MG', 'PA', 'PB', 'PR', 'PE', 'PI', 'RJ', 'RN', 'RS', 'RO',
          'RR', 'SC', 'SP', 'SE', 'TO'
        ];
    }

    function validRepresentedCompanyParentLink(data) {
      return data.parentCompanyId == ''
        || (
          exists(/databases/$(database)/documents/tenant_represented_companies/$(data.tenantId + '_' + data.parentCompanyId))
          && get(/databases/$(database)/documents/tenant_represented_companies/$(data.tenantId + '_' + data.parentCompanyId)).data.parentCompanyId == ''
        );
    }

    function validRepresentedCompanyDoc(docId, data) {
      return data.tenantId is string
        && data.tenantId != ''
        && data.companyId is string
        && data.companyId != ''
        && docId == data.tenantId + '_' + data.companyId
        && data.nomeFantasia is string
        && data.nomeFantasia != ''
        && data.razaoSocial is string
        && validRepresentedCompanyCnpj(data.cnpj)
        && validRepresentedCompanyCep(data.cep)
        && data.logoUrl is string
        && data.contato is string
        && validRepresentedCompanyPhone(data.telefone)
        && validRepresentedCompanyEmail(data.email)
        && data.cidade is string
        && validRepresentedCompanyUf(data.uf)
        && data.segmento is string
        && data.taxRegime is string
        && validTaxRegime(data.taxRegime)
        && data.parentCompanyId is string
        && data.parentCompanyId != data.companyId
        && validRepresentedCompanyParentLink(data)
        && data.ativo is bool;
    }

    function validProductUnitCatalogBaseEntryDoc(data) {
      return data.name is string
        && data.name != ''
        && data.normalizedName is string
        && data.normalizedName != '';
    }

    function validProductUnitCatalogShortCode(data) {
      return data.shortCode is string
        && data.shortCode != ''
        && data.shortCode.size() <= 4
        && data.normalizedShortCode is string
        && data.normalizedShortCode != ''
        && data.normalizedShortCode.size() <= 4;
    }

    function validProductMeasureUnitCatalogEntryDoc(data) {
      return validProductUnitCatalogBaseEntryDoc(data)
        && validProductUnitCatalogShortCode(data);
    }

    function validProductStandardUnitCatalogEntryDoc(data) {
      return validProductUnitCatalogBaseEntryDoc(data);
    }

    function validProductUnitCatalogMetaDoc(data) {
      return data.defaultsSeeded is bool;
    }

    function validProductMeasureUnitCatalogDoc(unitId, data) {
      return (unitId == '__catalog_meta__' && validProductUnitCatalogMetaDoc(data))
        || (unitId != '__catalog_meta__' && validProductMeasureUnitCatalogEntryDoc(data));
    }

    function validProductStandardUnitCatalogDoc(unitId, data) {
      return (unitId == '__catalog_meta__' && validProductUnitCatalogMetaDoc(data))
        || (unitId != '__catalog_meta__' && validProductStandardUnitCatalogEntryDoc(data));
    }

    function isInvitationRecipient(data) {
      return data.invitedEmail is string
        && request.auth.token.email is string
        && request.auth.token.email == data.invitedEmail;
    }

    function canReadMembershipDoc(data) {
      return isPlatformAdmin()
        || uid() == data.uid
        || (data.ownerId is string && data.ownerId == uid())
        || isEffectiveTenantOwner(data.tenantId)
        || (isTenantGerente(data.tenantId)
          && data.gerenteId == uid()
          && (data.role == 'representante' || data.role == 'vendedor'))
        || (isTenantRepresentante(data.tenantId)
          && data.representanteId == uid()
          && data.role == 'vendedor');
    }

    function canReadInvitationDoc(data) {
      return isPlatformAdmin()
        || (
          hasTenantAccessContext(data.tenantId)
          && (
            isEffectiveTenantOwner(data.tenantId)
            || (data.createdByUid is string && data.createdByUid == uid())
          )
        )
        || isInvitationRecipient(data);
    }

    function canRevokeInvitationDoc(data) {
      return isPlatformAdmin()
        || (
          hasTenantAccessContext(data.tenantId)
          && (
            isEffectiveTenantOwner(data.tenantId)
            || (
              data.createdByUid is string
              && data.createdByUid != ''
              && data.createdByUid == uid()
            )
          )
        );
    }

    function validHierarchyMovementDoc(movementId, data) {
      return data.movementId == movementId
        && data.tenantId is string
        && data.tenantId != ''
        && data.subjectUid is string
        && data.subjectUid != ''
        && validTenantRole(data.subjectRole)
        && data.fromOwnerId is string
        && data.fromGerenteId is string
        && data.fromRepresentanteId is string
        && data.fromVendedorId is string
        && data.toOwnerId is string
        && data.toGerenteId is string
        && data.toRepresentanteId is string
        && data.toVendedorId is string
        && data.reason is string
        && data.reason != ''
        && data.actorUid is string
        && data.actorUid == uid()
        && data.createdAt is string;
    }

    function canCreateHierarchyMovementDoc(data) {
      return isPlatformAdmin()
        || (
          hasTenantAccessContext(data.tenantId)
          && isEffectiveTenantOwner(data.tenantId)
          && data.fromOwnerId == uid()
          && data.toOwnerId == uid()
        );
    }

    function canReadHierarchyMovementDoc(data) {
      return isPlatformAdmin()
        || (
          hasTenantAccessContext(data.tenantId)
          && isEffectiveTenantOwner(data.tenantId)
        );
    }

    function validTenantMembershipAuditAction(action) {
      return action in [
        'membership_revoked',
        'membership_deactivated',
        'membership_reactivated',
        'membership_role_changed',
        'tenant_policy_updated'
      ];
    }

    function validTenantMembershipAuditDoc(data) {
      return data.tenantId is string
        && data.tenantId != ''
        && data.membershipId is string
        && validTenantMembershipAuditAction(data.action)
        && data.actorUid is string
        && data.actorUid != ''
        && data.createdAt is string
        && (!('actorLabel' in data) || data.actorLabel is string)
        && (!('actorEmail' in data) || data.actorEmail is string)
        && (!('details' in data) || data.details == null || data.details is map);
    }

    function canReadTenantMembershipAuditDoc(data) {
      return isPlatformAdmin()
        || (
          hasTenantAccessContext(data.tenantId)
          && (
            isEffectiveTenantOwner(data.tenantId)
            || isTenantGerente(data.tenantId)
            || isTenantRepresentante(data.tenantId)
          )
        );
    }

    function canCreateTenantMembershipAuditDoc(data) {
      return validTenantMembershipAuditDoc(data)
        && data.actorUid == uid()
        && (
          isPlatformAdmin()
          || isEffectiveTenantOwner(data.tenantId)
          || isTenantGerente(data.tenantId)
          || isTenantRepresentante(data.tenantId)
        )
        && (
          data.action != 'tenant_policy_updated'
          || isPlatformAdmin()
          || isEffectiveTenantOwner(data.tenantId)
        )
        && (
          data.action != 'membership_role_changed'
          || isPlatformAdmin()
          || isEffectiveTenantOwner(data.tenantId)
        );
    }

    function isPossibleSelfServiceBootstrapMembership(data) {
      return data.uid == uid()
        && data.defaultTenant == true
        && isSelfServiceOwnerTenantId(data.tenantId);
    }

    function validSelfServiceBootstrapMembership(membershipKey, data) {
      return validMembershipBaseDoc(membershipKey, data)
        && isPossibleSelfServiceBootstrapMembership(data)
        && (
          (isSoloTenant(data.tenantId)
            && data.role == 'vendedor'
            && data.ownerId == ''
            && data.gerenteId == ''
            && data.representanteId == ''
            && data.vendedorId == uid())
          || (isSelfServiceTeamOrEnterpriseTenant(data.tenantId)
            && data.role == 'owner'
            && (
              data.ownerId == uid()
              && data.gerenteId == uid()
              && data.representanteId == uid()
              && data.vendedorId == uid()))
        );
    }

    function validInvitationRoleForTenant(tenantId, role) {
      return validTenantRole(role)
        && (
          (isSellerSoloWorkspace(tenantId) && false)
          || (isRepWorkspace(tenantId) && role in ['representante', 'vendedor'])
          || (isBrandOwnerWorkspace(tenantId) && role in ['gerente', 'representante', 'vendedor'])
        );
    }

    function validInvitationDoc(data) {
      return data.token is string
        && data.token != ''
        && data.tenantId is string
        && data.tenantId != ''
        && validInvitationRoleForTenant(data.tenantId, data.role)
        && data.status in ['pending', 'accepted', 'declined', 'expired', 'revoked']
        && data.invitedEmail is string
        && data.invitedEmail != ''
        && data.createdByUid is string
        && data.createdByUid != ''
        && data.defaultTenant is bool;
    }

    function hasMatchingPendingInvitationForMembership(data) {
      return data.invitationToken is string
        && data.invitationToken != ''
        && exists(/databases/$(database)/documents/tenant_invitations/$(data.invitationToken))
        && get(/databases/$(database)/documents/tenant_invitations/$(data.invitationToken)).data.tenantId == data.tenantId
        && get(/databases/$(database)/documents/tenant_invitations/$(data.invitationToken)).data.role == data.role
        && get(/databases/$(database)/documents/tenant_invitations/$(data.invitationToken)).data.status == 'pending'
        && request.auth.token.email is string
        && get(/databases/$(database)/documents/tenant_invitations/$(data.invitationToken)).data.invitedEmail == request.auth.token.email
        && (myAccountContractLock() != 'enterprise_only' || tenantWorkspaceType(data.tenantId) == 'brand_owner_workspace')
        && data.uid == uid();
    }

    function canUpdateInvitationStatus(resourceData, requestData) {
      return resourceData.token == requestData.token
        && resourceData.tenantId == requestData.tenantId
        && resourceData.role == requestData.role
        && resourceData.invitedEmail == requestData.invitedEmail
        && resourceData.defaultTenant == requestData.defaultTenant
        && resourceData.createdByUid == requestData.createdByUid
        && (
          (
            resourceData.status == 'pending'
            && requestData.status == 'revoked'
            && requestData.revokedByUid == uid()
            && canRevokeInvitationDoc(resourceData)
          )
          || (
            resourceData.status == 'pending'
            && isInvitationRecipient(resourceData)
            && requestData.status == 'accepted'
            && requestData.acceptedByUid == uid()
          )
          || (
            resourceData.status == 'pending'
            && isInvitationRecipient(resourceData)
            && requestData.status == 'declined'
            && requestData.declinedByUid == uid()
          )
        );
    }

    function canManageOwnTenantSelection() {
      return resource.data.uid == uid()
        && request.resource.data.uid == uid()
        && resource.data.tenantId == request.resource.data.tenantId
        && resource.data.role == request.resource.data.role
        && resource.data.ativo == request.resource.data.ativo
        && resource.data.ownerId == request.resource.data.ownerId
        && resource.data.gerenteId == request.resource.data.gerenteId
        && resource.data.representanteId == request.resource.data.representanteId
        && resource.data.vendedorId == request.resource.data.vendedorId
        && resource.data.activeSellerChildrenCount == request.resource.data.activeSellerChildrenCount
        && resource.data.activeRepresentativeChildrenCount == request.resource.data.activeRepresentativeChildrenCount
        && resource.data.activeSubordinateCount == request.resource.data.activeSubordinateCount
        && request.resource.data.state == 'active';
    }

    function canUpdateOwnUserTenantContext(targetUid, data) {
      return targetUid == uid()
        && validPlatformUserDoc(targetUid, data)
        && data.platformRole == me().data.platformRole
        && data.ativoGlobal == true;
    }

    function canSelfServiceOwnerUpdateTenant(tenantId) {
      return uid() == resource.data.ownerUid
        && canAttemptSelfServiceTenantMutation(tenantId, request.resource.data)
        && validSelfServiceOwnerTenantDoc(tenantId, request.resource.data)
        && canChangeProductSyncFlag(tenantId);
    }

    function canTenantOwnerManageTenantDocumentUpdate(tenantId) {
      return uid() == resource.data.ownerUid
        && isEffectiveTenantOwner(tenantId)
        && validTenantDoc(tenantId, request.resource.data)
        && validWorkspaceTypeFields(request.resource.data)
        && validProductSyncFlagForWorkspace(request.resource.data)
        && canChangeProductSyncFlag(tenantId);
    }

    function canCreateMembershipDocByPlatformAdmin(membershipKey, data) {
      return isPlatformAdmin()
        && validMembershipDoc(membershipKey, data)
        && hasZeroHierarchyAggregates(data);
    }

    function canCreateMembershipDocByDirectSuperior(membershipKey, data) {
      return canManageMembershipByDirectSuperior(data)
        && validManagedMembershipByDirectSuperior(membershipKey, data)
        && data.ativo == true
        && data.state == 'active'
        && hasZeroHierarchyAggregates(data);
    }

    function canCreateMembershipDocByInvitation(membershipKey, data) {
      return hasMatchingPendingInvitationForMembership(data)
        && validMembershipDoc(membershipKey, data)
        && hasZeroHierarchyAggregates(data);
    }

    function canCreateMembershipDocBySelfServiceBootstrap(membershipKey, data) {
      return isPossibleSelfServiceBootstrapMembership(data)
        && validSelfServiceBootstrapMembership(membershipKey, data)
        && hasZeroHierarchyAggregates(data);
    }

    function canCreateMembershipDoc(membershipKey, data) {
      return canCreateMembershipDocByPlatformAdmin(membershipKey, data)
        || canCreateMembershipDocByDirectSuperior(membershipKey, data)
        || canCreateMembershipDocByInvitation(membershipKey, data)
        || canCreateMembershipDocBySelfServiceBootstrap(membershipKey, data);
    }

    function canUpdateMembershipDocByPlatformAdmin(membershipKey, data) {
      return isPlatformAdmin()
        && validMembershipDoc(membershipKey, data);
    }

    function canUpdateMembershipDocByDirectSuperior(membershipKey, data) {
      return canManageMembershipByDirectSuperior(data)
        && validManagedMembershipByDirectSuperior(membershipKey, data);
    }

    function canUpdateMembershipDocByOwnTenantSelection(membershipKey, data) {
      return canManageOwnTenantSelection()
        && validMembershipDoc(membershipKey, data);
    }

    function canUpdateMembershipDocBySelfServiceBootstrap(membershipKey, data) {
      return isPossibleSelfServiceBootstrapMembership(data)
        && validSelfServiceBootstrapMembership(membershipKey, data);
    }

    function isHierarchyLeadershipRole(role) {
      return role == 'gerente' || role == 'representante';
    }

    function hasLeadershipRoleTransitionRisk() {
      return isHierarchyLeadershipRole(resource.data.role)
        && request.resource.data.role != resource.data.role;
    }

    function hasLeadershipDeactivationRisk() {
      return isHierarchyLeadershipRole(resource.data.role)
        && resource.data.ativo == true
        && request.resource.data.ativo == false;
    }

    function hasLeadershipRevocationRisk() {
      return isHierarchyLeadershipRole(resource.data.role)
        && resource.data.state is string
        && request.resource.data.state is string
        && resource.data.state != 'revoked'
        && request.resource.data.state == 'revoked';
    }

    function hasLeadershipDestructiveTransitionRisk() {
      return hasLeadershipRoleTransitionRisk()
        || hasLeadershipDeactivationRisk()
        || hasLeadershipRevocationRisk();
    }

    function hasNoStoredActiveSubordinates() {
      return resource.data.activeSubordinateCount is int
        && resource.data.activeSubordinateCount == 0;
    }

    function canApplyLeadershipTransitionSafety() {
      return !hasLeadershipDestructiveTransitionRisk()
        || hasNoStoredActiveSubordinates();
    }

    function canUpdateMembershipDoc(membershipKey, data) {
      return canApplyLeadershipTransitionSafety()
        && (
          canUpdateMembershipDocByPlatformAdmin(membershipKey, data)
        || canUpdateMembershipDocByDirectSuperior(membershipKey, data)
        || canUpdateMembershipDocByOwnTenantSelection(membershipKey, data)
        || canUpdateMembershipDocBySelfServiceBootstrap(membershipKey, data)
        );
    }

    function canDeleteMembershipDoc(data) {
      return isPlatformAdmin()
        || canManageMembershipByDirectSuperior(data);
    }

    match /tenants/{tenantId} {
      allow read: if canReadTenantDocument(tenantId);

      allow create: if signedIn()
        && (
          (isPlatformAdmin() && validTenantDoc(tenantId, request.resource.data))
          || (
            canAttemptSelfServiceTenantMutation(tenantId, request.resource.data)
            && validSelfServiceOwnerTenantDoc(tenantId, request.resource.data)
          )
        );

      allow update: if signedIn()
        && (
          (isPlatformAdmin() && validTenantDoc(tenantId, request.resource.data))
          || canUpdateTenantAsNonAdmin(tenantId)
        );

      allow delete: if signedIn() && isPlatformAdmin();
    }

    match /tenants/{tenantId}/product_measure_units/{unitId} {
      allow read: if signedIn() && canReadTenantDocument(tenantId);

      allow create: if signedIn()
        && canManageProductCatalogWrite(tenantId)
        && validProductMeasureUnitCatalogDoc(unitId, request.resource.data);

      allow update: if signedIn()
        && canManageProductCatalogWrite(tenantId)
        && validProductMeasureUnitCatalogDoc(unitId, request.resource.data);

      allow delete: if signedIn()
        && canManageProductCatalogWrite(tenantId)
        && unitId != '__catalog_meta__';
    }

    match /tenants/{tenantId}/product_standard_units/{unitId} {
      allow read: if signedIn() && canReadTenantDocument(tenantId);

      allow create: if signedIn()
        && canManageProductCatalogWrite(tenantId)
        && validProductStandardUnitCatalogDoc(unitId, request.resource.data);

      allow update: if signedIn()
        && canManageProductCatalogWrite(tenantId)
        && validProductStandardUnitCatalogDoc(unitId, request.resource.data);

      allow delete: if signedIn()
        && canManageProductCatalogWrite(tenantId)
        && unitId != '__catalog_meta__';
    }

    match /usuarios/{targetUid} {
      allow read: if signedIn() && (isPlatformAdmin() || uid() == targetUid);

      allow create: if signedIn()
        && (
          (isPlatformAdmin() && validPlatformUserDoc(targetUid, request.resource.data))
          || validSelfServiceUserDoc(targetUid, request.resource.data)
        );

      allow update: if signedIn()
        && (
          (isPlatformAdmin() && validPlatformUserDoc(targetUid, request.resource.data))
          || validSelfServiceUserDoc(targetUid, request.resource.data)
          || canUpdateOwnUserTenantContext(targetUid, request.resource.data)
        );

      allow delete: if signedIn() && isPlatformAdmin();
    }

    match /tenant_memberships/{membershipKey} {
      allow read: if signedIn() && canReadMembershipDoc(resource.data);

      allow create: if signedIn()
        && canCreateMembershipDoc(membershipKey, request.resource.data);

      allow update: if signedIn()
        && resource.data.tenantId == request.resource.data.tenantId
        && resource.data.uid == request.resource.data.uid
        && canUpdateMembershipDoc(membershipKey, request.resource.data);

      allow delete: if signedIn() && canDeleteMembershipDoc(resource.data);
    }

    match /tenant_invitations/{token} {
      allow read: if signedIn() && (
        canReadInvitationDoc(resource.data)
      );

      allow create: if signedIn()
        && request.resource.data.token == token
        && request.resource.data.createdByUid == uid()
        && request.resource.data.status == 'pending'
        && canInviteRoleForTenant(request.resource.data.tenantId, request.resource.data.role)
        && validInvitationDoc(request.resource.data);

      allow update: if signedIn()
        && canUpdateInvitationStatus(resource.data, request.resource.data)
        && validInvitationDoc(request.resource.data);

      allow delete: if signedIn() && (
        canRevokeInvitationDoc(resource.data)
      );
    }

    match /tenant_hierarchy_movements/{movementId} {
      allow read: if signedIn() && canReadHierarchyMovementDoc(resource.data);

      allow create: if signedIn()
        && validHierarchyMovementDoc(movementId, request.resource.data)
        && canCreateHierarchyMovementDoc(request.resource.data);

      allow update, delete: if false;
    }

    match /tenant_membership_audit/{auditId} {
      allow read: if signedIn() && canReadTenantMembershipAuditDoc(resource.data);

      allow create: if signedIn()
        && canCreateTenantMembershipAuditDoc(request.resource.data);

      allow update, delete: if false;
    }

    match /solicitacoes_acesso/{requestId} {
      allow create: if signedIn()
        && request.resource.data.uid == uid()
        && request.resource.data.status == 'pendente';

      allow read: if signedIn() && (uid() == resource.data.uid || isPlatformAdmin());

      allow update: if signedIn() && (
          isPlatformAdmin()
          || (
            uid() == resource.data.uid
            && request.resource.data.uid == uid()
            && request.resource.data.status == 'pendente'
          )
        );

      allow delete: if signedIn() && (isPlatformAdmin() || uid() == resource.data.uid);
    }

    match /clientes/{clienteId} {
      allow read: if canReadTenantBoundDocument(resource.data);

      allow create: if hasScopeFields(request.resource.data)
        && request.resource.data.taxRegime is string
        && validTaxRegime(request.resource.data.taxRegime)
        && canWriteScopedData(request.resource.data);

      allow update: if hasScopeFields(request.resource.data)
        && request.resource.data.taxRegime is string
        && validTaxRegime(request.resource.data.taxRegime)
        && immutableScopeOnUpdate()
        && canWriteScopedData(request.resource.data);

      allow delete: if hasScopeFields(resource.data)
        && canDeleteCliente(resource.data);
    }

    function validPreCadastroDoc(data) {
      return data.tenantId is string
        && data.tenantId != ''
        && data.nome is string
        && data.documento is string
        && data.status is string
        && data.taxRegime is string
        && validTaxRegime(data.taxRegime)
        && data.requestedByUid is string;
    }

    match /cliente_pre_cadastros/{preCadastroId} {
      allow read: if signedIn() && canAccessTenantWorkflow(resource.data.tenantId);

      allow create: if signedIn()
        && validPreCadastroDoc(request.resource.data)
        && canAccessTenantWorkflow(request.resource.data.tenantId);

      allow update: if signedIn()
        && validPreCadastroDoc(request.resource.data)
        && resource.data.tenantId == request.resource.data.tenantId
        && canAccessTenantWorkflow(request.resource.data.tenantId);

      allow delete: if signedIn() && canAccessTenantWorkflow(resource.data.tenantId);
    }

    match /produtos/{produtoId} {
      allow read: if canReadTenantBoundDocument(resource.data);

      allow create: if hasTenantField(request.resource.data)
        && (!('grupo_tributario_id' in request.resource.data)
          || request.resource.data.grupo_tributario_id is string)
        && canManageProductCatalogWrite(request.resource.data.tenantId);

      allow update: if hasTenantField(request.resource.data)
        && (!('grupo_tributario_id' in request.resource.data)
          || request.resource.data.grupo_tributario_id is string)
        && resource.data.tenantId == request.resource.data.tenantId
        && canManageProductCatalogWrite(request.resource.data.tenantId);

      allow delete: if hasTenantField(resource.data)
        && canManageProductCatalogWrite(resource.data.tenantId);
    }

    match /product_media_assets/{assetId} {
      allow read: if canReadTenantBoundDocument(resource.data);

      allow create: if hasTenantField(request.resource.data)
        && canManageProductCatalogWrite(request.resource.data.tenantId);

      allow update: if hasTenantField(request.resource.data)
        && resource.data.tenantId == request.resource.data.tenantId
        && canManageProductCatalogWrite(request.resource.data.tenantId);

      allow delete: if hasTenantField(resource.data)
        && canManageProductCatalogWrite(resource.data.tenantId);
    }

    match /tenant_counters/{tenantId} {
      allow read: if signedIn()
        && (resource == null || resource.data.tenantId == tenantId)
        && canReadTenantDocument(tenantId);

      allow create: if signedIn()
        && request.resource.data.tenantId == tenantId
        && canManageProductCatalogWrite(tenantId);

      allow update: if signedIn()
        && request.resource.data.tenantId == tenantId
        && resource.data.tenantId == tenantId
        && canManageProductCatalogWrite(tenantId);

      allow delete: if false;
    }

    match /tabelas_preco/{tabelaId} {
      allow read: if canReadTenantBoundDocument(resource.data);

      allow create: if hasTenantField(request.resource.data)
        && canManagePriceTableWrite(request.resource.data.tenantId);

      allow update: if hasTenantField(request.resource.data)
        && resource.data.tenantId == request.resource.data.tenantId
        && canManagePriceTableWrite(request.resource.data.tenantId);

      allow delete: if hasTenantField(resource.data)
        && canManagePriceTableWrite(resource.data.tenantId);
    }

    match /tax_rules/{ruleId} {
      allow read: if hasTenantField(resource.data)
        && (
          isPlatformAdmin()
          || isPersonalWorkspaceTenant(resource.data.tenantId)
          || hasTenantAccessContext(resource.data.tenantId)
        );

      allow create: if hasTenantField(request.resource.data)
        && canManageTaxRulesWrite(request.resource.data.tenantId);

      allow update: if hasTenantField(request.resource.data)
        && resource.data.tenantId == request.resource.data.tenantId
        && canManageTaxRulesWrite(request.resource.data.tenantId);

      allow delete: if hasTenantField(resource.data)
        && canManageTaxRulesWrite(resource.data.tenantId);
    }

    match /tax_rule_groups/{groupId} {
      allow read: if hasTenantField(resource.data)
        && (
          isPlatformAdmin()
          || isPersonalWorkspaceTenant(resource.data.tenantId)
          || hasTenantAccessContext(resource.data.tenantId)
        );

      allow create: if hasTenantField(request.resource.data)
        && canManageTaxRulesWrite(request.resource.data.tenantId);

      allow update: if hasTenantField(request.resource.data)
        && resource.data.tenantId == request.resource.data.tenantId
        && canManageTaxRulesWrite(request.resource.data.tenantId);

      allow delete: if hasTenantField(resource.data)
        && canManageTaxRulesWrite(resource.data.tenantId);
    }

    match /tax_operation_profiles/{profileId} {
      allow read: if hasTenantField(resource.data)
        && (
          isPlatformAdmin()
          || isPersonalWorkspaceTenant(resource.data.tenantId)
          || hasTenantAccessContext(resource.data.tenantId)
        );

      allow create: if hasTenantField(request.resource.data)
        && canManageTaxRulesWrite(request.resource.data.tenantId);

      allow update: if hasTenantField(request.resource.data)
        && resource.data.tenantId == request.resource.data.tenantId
        && canManageTaxRulesWrite(request.resource.data.tenantId);

      allow delete: if hasTenantField(resource.data)
        && canManageTaxRulesWrite(resource.data.tenantId);
    }

    match /product_base_prices/{basePriceId} {
      allow read: if canReadTenantBoundDocument(resource.data);

      allow create: if hasTenantField(request.resource.data)
        && canManagePriceTableWrite(request.resource.data.tenantId);

      allow update: if hasTenantField(request.resource.data)
        && resource.data.tenantId == request.resource.data.tenantId
        && canManagePriceTableWrite(request.resource.data.tenantId);

      allow delete: if hasTenantField(resource.data)
        && canManagePriceTableWrite(resource.data.tenantId);
    }

    match /discount_policies/{policyId} {
      allow read: if canReadTenantBoundDocument(resource.data);

      allow create: if hasTenantField(request.resource.data)
        && canManagePriceTableWrite(request.resource.data.tenantId);

      allow update: if hasTenantField(request.resource.data)
        && resource.data.tenantId == request.resource.data.tenantId
        && canManagePriceTableWrite(request.resource.data.tenantId);

      allow delete: if hasTenantField(resource.data)
        && canManagePriceTableWrite(resource.data.tenantId);
    }

    match /customer_product_rules/{ruleId} {
      allow read: if canReadTenantBoundDocument(resource.data);

      allow create: if hasTenantField(request.resource.data)
        && canManagePriceTableWrite(request.resource.data.tenantId);

      allow update: if hasTenantField(request.resource.data)
        && resource.data.tenantId == request.resource.data.tenantId
        && canManagePriceTableWrite(request.resource.data.tenantId);

      allow delete: if hasTenantField(resource.data)
        && canManagePriceTableWrite(resource.data.tenantId);
    }

    match /customer_price_table_assignments/{assignmentId} {
      allow read: if canReadTenantBoundDocument(resource.data);

      allow create: if hasTenantField(request.resource.data)
        && canManagePriceTableWrite(request.resource.data.tenantId);

      allow update: if hasTenantField(request.resource.data)
        && resource.data.tenantId == request.resource.data.tenantId
        && canManagePriceTableWrite(request.resource.data.tenantId);

      allow delete: if hasTenantField(resource.data)
        && canManagePriceTableWrite(resource.data.tenantId);
    }

    match /tenant_represented_companies/{companyDocId} {
      allow read: if canReadTenantBoundDocument(resource.data);

      allow create: if validRepresentedCompanyDoc(companyDocId, request.resource.data)
        && canManageRepresentedCompanyWrite(request.resource.data.tenantId);

      allow update: if validRepresentedCompanyDoc(companyDocId, request.resource.data)
        && resource.data.tenantId == request.resource.data.tenantId
        && resource.data.companyId == request.resource.data.companyId
        && canManageRepresentedCompanyWrite(request.resource.data.tenantId);

      allow delete: if hasTenantField(resource.data)
        && canManageRepresentedCompanyWrite(resource.data.tenantId);
    }

    match /pedidos/{pedidoId} {
      allow read: if canReadTenantBoundDocument(resource.data);

      allow create: if hasScopeFields(request.resource.data)
        && canWriteScopedData(request.resource.data);

      allow update: if hasScopeFields(request.resource.data)
        && immutableScopeOnUpdate()
        && canWriteScopedData(request.resource.data);

      allow delete: if hasScopeFields(resource.data)
        && (isPlatformAdmin()
          || canAccessOwnPersonalData(resource.data)
          || isEffectiveTenantOwner(resource.data.tenantId));
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
