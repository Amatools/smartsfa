      "requestBody": {
        "sql": "WITH C AS (\r\n    SELECT\r\n        TABLE_NAME,\r\n        COLUMN_NAME\r\n    FROM ALL_TAB_COLUMNS\r\n)\r\nSELECT\r\n    TABLE_NAME,\r\n    MAX(CASE WHEN COLUMN_NAME = 'CODTRIB' THEN 1 ELSE 0 END) AS HAS_CODTRIB,\r\n    MAX(CASE WHEN COLUMN_NAME = 'IDALIQ' THEN 1 ELSE 0 END) AS HAS_IDALIQ,\r\n    MAX(CASE WHEN COLUMN_NAME LIKE '%CODPROD%' THEN 1 ELSE 0 END) AS HAS_CODPROD,\r\n    MAX(CASE WHEN COLUMN_NAME LIKE '%NCM%' THEN 1 ELSE 0 END) AS HAS_NCM,\r\n    MAX(CASE WHEN COLUMN_NAME LIKE '%CEST%' OR COLUMN_NAME LIKE '%CODESPECST%' THEN 1 ELSE 0 END) AS HAS_CEST,\r\n    MAX(CASE WHEN COLUMN_NAME LIKE '%GRUPOICMS%' THEN 1 ELSE 0 END) AS HAS_GRUPOICMS\r\nFROM C\r\nGROUP BY TABLE_NAME\r\nHAVING MAX(CASE WHEN COLUMN_NAME = 'CODTRIB' THEN 1 ELSE 0 END) = 1\r\n    OR MAX(CASE WHEN COLUMN_NAME = 'IDALIQ' THEN 1 ELSE 0 END) = 1\r\nORDER BY\r\n    HAS_CODTRIB DESC,\r\n    HAS_IDALIQ DESC,\r\n    HAS_CODPROD DESC,\r\n    HAS_NCM DESC,\r\n    HAS_CEST DESC,\r\n    HAS_GRUPOICMS DESC,\r\n    TABLE_NAME"
      }
    }
