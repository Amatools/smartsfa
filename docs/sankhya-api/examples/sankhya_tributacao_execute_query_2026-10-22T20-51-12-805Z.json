        "sql": "SELECT\r\n    NVL(TO_CHAR(ICM.TIPRESTRICAO), '-') AS TIPRESTRICAO,\r\n    NVL(TO_CHAR(ICM.TIPRESTRICAO2), '-') AS TIPRESTRICAO2,\r\n    COUNT(*) AS TOTAL,\r\n    SUM(\r\n        CASE\r\n            WHEN NVL(TO_CHAR(ICM.CODRESTRICAO), '-1') IN ('-1', '0') THEN 1\r\n            ELSE 0\r\n        END\r\n    ) AS CODRESTRICAO_GENERICO,\r\n    SUM(\r\n        CASE\r\n            WHEN NVL(TO_CHAR(ICM.CODRESTRICAO2), '-1') IN ('-1', '0') THEN 1\r\n            ELSE 0\r\n        END\r\n    ) AS CODRESTRICAO2_GENERICO,\r\n    SUM(\r\n        CASE\r\n            WHEN NVL(ICM.ALIQSUBTRIB, 0) = 0\r\n             AND NVL(ICM.ALIQINTDEST, 0) = 0\r\n             AND NVL(ICM.ALIQUOTA, 0) = 0\r\n            THEN 1\r\n            ELSE 0\r\n        END\r\n    ) AS LINHAS_ALIQUOTA_ZERO,\r\n    COUNT(DISTINCT NVL(TO_CHAR(ICM.CODTRIB), '-')) AS CODTRIB_DISTINTOS,\r\n    COUNT(DISTINCT NVL(TO_CHAR(ICM.IDALIQ), '-')) AS IDALIQ_DISTINTOS\r\nFROM TGFICM ICM\r\nGROUP BY\r\n    NVL(TO_CHAR(ICM.TIPRESTRICAO), '-'),\r\n    NVL(TO_CHAR(ICM.TIPRESTRICAO2), '-')\r\nORDER BY TOTAL DESC"
      }
    }
