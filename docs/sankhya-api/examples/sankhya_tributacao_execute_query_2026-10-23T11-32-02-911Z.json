      "serviceName": "DbExplorerSP.executeQuery",
      "requestBody": {
        "sql": "WITH RESTR AS (\r\n    SELECT\r\n        'R1' AS LADO,\r\n        NVL(TO_CHAR(ICM.TIPRESTRICAO), '-') AS TIPO,\r\n        NVL(ICM.CODRESTRICAO, -1) AS COD\r\n    FROM TGFICM ICM\r\n    WHERE NVL(TO_CHAR(ICM.CODRESTRICAO), '-1') NOT IN ('-1', '0')\r\n\r\n    UNION ALL\r\n\r\n    SELECT\r\n        'R2' AS LADO,\r\n        NVL(TO_CHAR(ICM.TIPRESTRICAO2), '-') AS TIPO,\r\n        NVL(ICM.CODRESTRICAO2, -1) AS COD\r\n    FROM TGFICM ICM\r\n    WHERE NVL(TO_CHAR(ICM.CODRESTRICAO2), '-1') NOT IN ('-1', '0')\r\n)\r\nSELECT\r\n    TIPO,\r\n    LADO,\r\n    COUNT(*) AS TOTAL,\r\n    SUM(CASE WHEN EXISTS (SELECT 1 FROM TGFPRO P WHERE P.CODPROD = R.COD AND ROWNUM = 1) THEN 1 ELSE 0 END) AS MATCH_PRODUTO,\r\n    SUM(CASE WHEN EXISTS (\r\n        SELECT 1\r\n        FROM TGFNCM N\r\n        WHERE LTRIM(TO_CHAR(R.COD), '0') = LTRIM(REPLACE(N.CODNCM, '.', ''), '0')\r\n          AND ROWNUM = 1\r\n    ) THEN 1 ELSE 0 END) AS MATCH_NCM,\r\n    SUM(CASE WHEN EXISTS (SELECT 1 FROM TGFPRO P WHERE NVL(P.GRUPOICMS, -1) = R.COD AND ROWNUM = 1) THEN 1 ELSE 0 END) AS MATCH_GRUPOICMS,\r\n    SUM(CASE WHEN EXISTS (SELECT 1 FROM TGFPRO P WHERE NVL(P.GRUPOICMS2, -1) = R.COD AND ROWNUM = 1) THEN 1 ELSE 0 END) AS MATCH_GRUPOICMS2\r\nFROM RESTR R\r\nGROUP BY TIPO, LADO\r\nORDER BY TOTAL DESC, TIPO, LADO"
      }
    }
  },
