        "sql": "SELECT\r\n    CASE\r\n        WHEN NVL(PRO.GRUPOICMS, -1) = NVL(ICM.CODTRIB, -2) THEN 'GRUPOICMS'\r\n        WHEN NVL(PRO.GRUPOICMS2, -1) = NVL(ICM.CODTRIB, -2) THEN 'GRUPOICMS2'\r\n        ELSE 'SEM_MAPEAMENTO'\r\n    END AS TIPO_MAPEAMENTO,\r\n    COUNT(*) AS TOTAL_COMBINACOES,\r\n    COUNT(DISTINCT ICM.CODTRIB) AS CODTRIB_DISTINTOS,\r\n    COUNT(DISTINCT PRO.CODPROD) AS PRODUTOS_DISTINTOS,\r\n    COUNT(DISTINCT PRO.NCM) AS NCM_DISTINTOS,\r\n    COUNT(DISTINCT PRO.CODESPECST) AS CEST_DISTINTOS\r\nFROM TGFICM ICM\r\nLEFT JOIN TGFPRO PRO\r\n    ON PRO.ATIVO = 'S'\r\n   AND (\r\n        NVL(PRO.GRUPOICMS, -1) = NVL(ICM.CODTRIB, -2)\r\n        OR NVL(PRO.GRUPOICMS2, -1) = NVL(ICM.CODTRIB, -2)\r\n   )\r\nWHERE\r\n    NVL(TO_CHAR(ICM.CODRESTRICAO), '-1') IN ('-1', '0')\r\n    AND NVL(TO_CHAR(ICM.CODRESTRICAO2), '-1') IN ('-1', '0')\r\nGROUP BY\r\n    CASE\r\n        WHEN NVL(PRO.GRUPOICMS, -1) = NVL(ICM.CODTRIB, -2) THEN 'GRUPOICMS'\r\n        WHEN NVL(PRO.GRUPOICMS2, -1) = NVL(ICM.CODTRIB, -2) THEN 'GRUPOICMS2'\r\n        ELSE 'SEM_MAPEAMENTO'\r\n    END\r\nORDER BY TOTAL_COMBINACOES DESC"
      }
    }
