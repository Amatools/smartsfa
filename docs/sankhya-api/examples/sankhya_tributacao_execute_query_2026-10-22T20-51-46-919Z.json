        "sql": "SELECT\r\n    NVL(TO_CHAR(ICM.CODTRIB), '-') AS CODTRIB,\r\n    NVL(TO_CHAR(ICM.IDALIQ), '-') AS IDALIQ,\r\n    NVL(TO_CHAR(ICM.TIPRESTRICAO), '-') AS TIPRESTRICAO,\r\n    NVL(TO_CHAR(ICM.TIPRESTRICAO2), '-') AS TIPRESTRICAO2,\r\n    COUNT(*) AS TOTAL,\r\n    MIN(NVL(ICM.ALIQSUBTRIB, 0)) AS MIN_ALIQSUBTRIB,\r\n    MAX(NVL(ICM.ALIQSUBTRIB, 0)) AS MAX_ALIQSUBTRIB,\r\n    MIN(NVL(ICM.ALIQINTDEST, 0)) AS MIN_ALIQINTDEST,\r\n    MAX(NVL(ICM.ALIQINTDEST, 0)) AS MAX_ALIQINTDEST,\r\n    MIN(NVL(ICM.ALIQUOTA, 0)) AS MIN_ALIQUOTA,\r\n    MAX(NVL(ICM.ALIQUOTA, 0)) AS MAX_ALIQUOTA\r\nFROM TGFICM ICM\r\nGROUP BY\r\n    NVL(TO_CHAR(ICM.CODTRIB), '-'),\r\n    NVL(TO_CHAR(ICM.IDALIQ), '-'),\r\n    NVL(TO_CHAR(ICM.TIPRESTRICAO), '-'),\r\n    NVL(TO_CHAR(ICM.TIPRESTRICAO2), '-')\r\nORDER BY TOTAL DESC\r\nFETCH FIRST 50 ROWS ONLY"
      }
